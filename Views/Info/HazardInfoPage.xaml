<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SAFETY_STEPS.HazardInfoPage"
             Title="HazardInfopage">

    <ScrollView>
        <VerticalStackLayout Padding="0">

            <!-- Header -->
            <HorizontalStackLayout BackgroundColor="#ab0404" HeightRequest="60">
                <ImageButton
                    Source="backbtn.png"
                    HeightRequest="10"
                    WidthRequest="10"
                    VerticalOptions="Center"
                    Clicked="OnBackClicked"/>
                <Label
                    x:Name="HazardTitle"
                    TextColor="White"
                    FontSize="20"
                    FontFamily="PoppinsBold"
                    VerticalOptions="Center"/>
            </HorizontalStackLayout>

            <!-- Divider -->
            <BoxView HeightRequest="1" BackgroundColor="Grey" HorizontalOptions="Fill"/>

            <!-- Infographic Image -->
            <Image
                x:Name="HazardImage"
                HorizontalOptions="Fill"
                Aspect="AspectFit"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
