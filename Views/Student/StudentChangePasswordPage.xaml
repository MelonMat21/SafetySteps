<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SAFETY_STEPS.StudentChangePasswordPage"
             BackgroundColor="White"
             Title="Change Password"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- ── Header -->
            <Border Background="#ab0404" StrokeThickness="0"
                    StrokeShape="RoundRectangle 0,0,40,40">
                <Border.Shadow>
                    <Shadow Brush="#ab0404" Opacity="0.7" Offset="0,3" Radius="6"/>
                </Border.Shadow>
                <VerticalStackLayout HeightRequest="160" Padding="24,0"
                                     VerticalOptions="Center" Spacing="6">

                    <!-- Back arrow -->
                    <HorizontalStackLayout Margin="0,28,0,0">
                        <Border StrokeThickness="0" BackgroundColor="Transparent" Padding="0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBackTapped"/>
                            </Border.GestureRecognizers>
                            <Label Text="←" FontSize="22" TextColor="White"
                                   VerticalOptions="Center"/>
                        </Border>
                    </HorizontalStackLayout>

                    <Label Text="Change Password"
                           FontSize="22" FontFamily="PoppinsBold"
                           TextColor="White" HorizontalOptions="Center"/>
                    <Label Text="Update your account password"
                           FontSize="13" TextColor="#ffcccc"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>

            <!-- ── Form card -->
            <Border Stroke="#E0E0E0" StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    Margin="24,28,24,0" Padding="24">
                <Border.Shadow>
                    <Shadow Brush="#20000000" Offset="0,4" Radius="12" Opacity="1"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="18">

                    <!-- Current password -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Current Password"
                               FontSize="13" TextColor="Gray" FontFamily="PoppinsRegular"/>
                        <Border StrokeShape="RoundRectangle 10"
                                Stroke="#DDDDDD" StrokeThickness="1" Padding="12,0">
                            <Entry x:Name="CurrentPasswordEntry"
                                   Placeholder="Enter current password"
                                   IsPassword="True"
                                   FontFamily="PoppinsRegular"
                                   FontSize="14"
                                   TextColor="Black"
                                   HeightRequest="46"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- New password -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="New Password"
                               FontSize="13" TextColor="Gray" FontFamily="PoppinsRegular"/>
                        <Border StrokeShape="RoundRectangle 10"
                                Stroke="#DDDDDD" StrokeThickness="1" Padding="12,0">
                            <Entry x:Name="NewPasswordEntry"
                                   Placeholder="At least 6 characters"
                                   IsPassword="True"
                                   FontFamily="PoppinsRegular"
                                   FontSize="14"
                                   TextColor="Black"
                                   HeightRequest="46"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Confirm new password -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Confirm New Password"
                               FontSize="13" TextColor="Gray" FontFamily="PoppinsRegular"/>
                        <Border StrokeShape="RoundRectangle 10"
                                Stroke="#DDDDDD" StrokeThickness="1" Padding="12,0">
                            <Entry x:Name="ConfirmPasswordEntry"
                                   Placeholder="Re-enter new password"
                                   IsPassword="True"
                                   FontFamily="PoppinsRegular"
                                   FontSize="14"
                                   TextColor="Black"
                                   HeightRequest="46"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Status label (shown on error/success) -->
                    <Label x:Name="StatusLabel"
                           IsVisible="False"
                           FontSize="13"
                           FontFamily="PoppinsRegular"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           Margin="0,4"/>

                    <!-- Save button -->
                    <Button x:Name="SaveButton"
                            Text="Update Password"
                            Clicked="OnSavePasswordClicked"
                            BackgroundColor="#ab0404"
                            TextColor="White"
                            FontFamily="PoppinsBold"
                            CornerRadius="12"
                            HeightRequest="50"
                            Margin="0,6,0,0">
                        <Button.Shadow>
                            <Shadow Brush="#ab0404" Opacity="0.4" Radius="10" Offset="4,4"/>
                        </Button.Shadow>
                    </Button>

                </VerticalStackLayout>
            </Border>

            <!-- Note about admin-reset passwords -->
            <Border Stroke="#E3F2FD" BackgroundColor="#E3F2FD"
                    StrokeThickness="0" StrokeShape="RoundRectangle 12"
                    Margin="24,20,24,32" Padding="16,12">
                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                    <Label Text="ℹ️" FontSize="20" VerticalOptions="Center"/>
                    <Label Text="If your password was reset by an admin, use the temporary password they provided as your current password."
                           FontSize="12" TextColor="#1565C0"
                           FontFamily="PoppinsRegular"
                           VerticalOptions="Center"
                           HorizontalOptions="FillAndExpand"
                           LineBreakMode="WordWrap"/>
                </HorizontalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
