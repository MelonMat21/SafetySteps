<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SAFETY_STEPS.CallPage"
             Title="Call"
             BackgroundColor="#0f0f1e">

    <Grid RowDefinitions="*, Auto">

        <!-- ── Main content ─────────────────────────────────────── -->
        <VerticalStackLayout Grid.Row="0"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="20">

            <!-- Receiver avatar -->
            <Border StrokeShape="RoundRectangle 60"
                    WidthRequest="120" HeightRequest="120"
                    BackgroundColor="#1e1e3f"
                    HorizontalOptions="Center">
                <Label Text="🧑‍🎓"
                       FontSize="56"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>

            <!-- Receiver name -->
            <Label Text="{Binding ReceiverName}"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center" />

            <!-- Status -->
            <Label Text="{Binding StatusText}"
                   FontSize="15"
                   TextColor="#8888bb"
                   HorizontalOptions="Center" />

            <!-- Urgent toggle (student-controlled before calling) -->
            <HorizontalStackLayout Spacing="10"
                                   HorizontalOptions="Center"
                                   IsVisible="{Binding IsIdle}">
                <Label Text="Mark as URGENT"
                       FontSize="13"
                       TextColor="#ff9e9e"
                       VerticalOptions="Center" />
                <Switch IsToggled="{Binding IsUrgent}" />
            </HorizontalStackLayout>

            <!-- Ringing animation label -->
            <Label Text="📳 Ringing…"
                   FontSize="14"
                   TextColor="#ffcc00"
                   HorizontalOptions="Center"
                   IsVisible="{Binding IsCalling}" />

            <!-- Connected indicator -->
            <HorizontalStackLayout HorizontalOptions="Center"
                                   Spacing="8"
                                   IsVisible="{Binding IsCallActive}">
                <Ellipse WidthRequest="10" HeightRequest="10" Fill="#00e676" />
                <Label Text="Live" TextColor="#00e676" FontSize="14" />
            </HorizontalStackLayout>

        </VerticalStackLayout>

        <!-- ── Buttons ───────────────────────────────────────────── -->
        <Grid Grid.Row="1" Margin="0,0,0,56">

            <!-- Start call (idle state) -->
            <VerticalStackLayout HorizontalOptions="Center"
                                 Spacing="8"
                                 IsVisible="{Binding IsIdle}">
                <Border StrokeShape="RoundRectangle 40"
                        WidthRequest="80" HeightRequest="80"
                        BackgroundColor="#00c853">
                    <Label Text="📞" FontSize="32"
                           HorizontalOptions="Center"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCallTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <Label Text="Call" TextColor="#8888bb" FontSize="13"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Cancel (ringing) -->
            <VerticalStackLayout HorizontalOptions="Center"
                                 Spacing="8"
                                 IsVisible="{Binding IsCalling}">
                <Border StrokeShape="RoundRectangle 40"
                        WidthRequest="80" HeightRequest="80"
                        BackgroundColor="#e53935">
                    <Label Text="📵" FontSize="32"
                           HorizontalOptions="Center"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnEndCallTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <Label Text="Cancel" TextColor="#8888bb" FontSize="13"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Mute + End call (active call) -->
            <HorizontalStackLayout HorizontalOptions="Center"
                                   Spacing="40"
                                   IsVisible="{Binding IsCallActive}">

                <!-- Mute -->
                <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                    <Border StrokeShape="RoundRectangle 35"
                            WidthRequest="70" HeightRequest="70"
                            BackgroundColor="#1e1e3f"
                            Stroke="#3a3aff">
                        <Label Text="{Binding MuteIcon}" FontSize="28"
                               HorizontalOptions="Center"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMuteTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Border>
                    <Label Text="Mute" TextColor="#8888bb" FontSize="12"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Speaker -->
                <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                    <Border StrokeShape="RoundRectangle 35"
                            WidthRequest="70" HeightRequest="70"
                            BackgroundColor="#1e1e3f"
                            Stroke="#3a3aff">
                        <Label Text="🔊" FontSize="28"
                               HorizontalOptions="Center"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSpeakerTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Border>
                    <Label Text="Speaker" TextColor="#8888bb" FontSize="12"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- End call -->
                <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                    <Border StrokeShape="RoundRectangle 40"
                            WidthRequest="80" HeightRequest="80"
                            BackgroundColor="#e53935">
                        <Label Text="📵" FontSize="32"
                               HorizontalOptions="Center"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnEndCallTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Border>
                    <Label Text="End" TextColor="#8888bb" FontSize="12"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

            </HorizontalStackLayout>

        </Grid>
    </Grid>
</ContentPage>
