<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SAFETY_STEPS.HistoryPage"
             Title="HistoryPage"
             BackgroundColor="White">

    <ScrollView x:Name="ReportsScrollView">
        <VerticalStackLayout>
            <Border
                Background="#ab0404"
                StrokeThickness="0">

                <VerticalStackLayout
                    HeightRequest="60"
                    Background="#ab0404"
                    VerticalOptions="Start"
                    HorizontalOptions="Start"
                    Spacing="8"
                    Padding="10">

                    <HorizontalStackLayout Spacing="0">
                        <Label
                            Text="History Reports"
                            TextColor="White"
                            FontSize="18"
                            FontFamily="PoppinsBold"
                            Padding="10,8,0,0"/>    
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- ── Loading indicator ── -->
            <ActivityIndicator
                x:Name="LoadingIndicator"
                IsVisible="False"
                IsRunning="False"
                Color="#D90000"
                HeightRequest="48"
                Margin="0,24,0,0"/>

            <!-- ── Empty state ── -->
            <Border
                x:Name="EmptyState"
                IsVisible="False"
                Margin="18,24,18,0"
                Stroke="Gray"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 10"
                Padding="0,0,0,10"
                HeightRequest="250">
                <VerticalStackLayout
                    Spacing="3"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                    <Image
                        Source="quick.png"
                        HeightRequest="140"
                        WidthRequest="150"/>
                    <Label
                        Text="No Reports Yet"
                        TextColor="Black"
                        FontSize="16"
                        FontFamily="PoppinsSemiBold"
                        HorizontalOptions="Center"
                        Padding="0,0,0,5"/>
                    <Label
                        Text="Submit a report from the dashboard"
                        FontSize="11"
                        TextColor="Gray"
                        FontFamily="PoppinsRegular"
                        HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>

            <!-- ── Reports list ── -->
            <VerticalStackLayout x:Name="ReportsContainer" Spacing="0" Padding="0,8,0,20"/>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
