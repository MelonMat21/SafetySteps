<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SAFETY_STEPS.ReportHistoryAdmin"
             Title="ReportHistoryAdmin"
             BackgroundColor="White">

    <!--
        Layout (top → bottom):
          Row 0 – Header bar                    Auto
          Row 1 – Tab bar + bottom divider      Auto
          Row 2 – Loading / Empty state         Auto
          Row 3 – Scrollable report cards       * (fills remaining space)
    -->
    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- ══ Row 0 : Header ══════════════════════════════════ -->
        <Border Grid.Row="0" Background="#ab0404" StrokeThickness="0">
            <VerticalStackLayout
                HeightRequest="60"
                Background="#ab0404"
                VerticalOptions="Start"
                HorizontalOptions="Start"
                Spacing="8"
                Padding="10">
                <HorizontalStackLayout Spacing="0">
                    <Label Text="Report History"
                           TextColor="White"
                           FontSize="18"
                           FontFamily="PoppinsBold"
                           Padding="10,8,0,0"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!-- ══ Row 1 : Tab Bar ══════════════════════════════════ -->
        <VerticalStackLayout Grid.Row="1" BackgroundColor="White" Spacing="0">

            <Grid ColumnDefinitions="*,*" BackgroundColor="White">

                <!-- ── Ongoing Tab ── -->
                <VerticalStackLayout Grid.Column="0" Spacing="0">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnOngoingTabTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label x:Name="TabOngoingLabel"
                           Text="Ongoing"
                           HorizontalOptions="Center"
                           FontSize="14"
                           FontFamily="PoppinsBold"
                           TextColor="#ab0404"
                           Padding="0,12"/>
                    <BoxView x:Name="TabOngoingIndicator"
                             HeightRequest="3"
                             CornerRadius="2"
                             BackgroundColor="#ab0404"
                             HorizontalOptions="Fill"/>
                </VerticalStackLayout>

                <!-- ── Recent Tab ── -->
                <VerticalStackLayout Grid.Column="1" Spacing="0">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRecentTabTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label x:Name="TabRecentLabel"
                           Text="Recent"
                           HorizontalOptions="Center"
                           FontSize="14"
                           FontFamily="PoppinsRegular"
                           TextColor="#9E9E9E"
                           Padding="0,12"/>
                    <BoxView x:Name="TabRecentIndicator"
                             HeightRequest="3"
                             CornerRadius="2"
                             BackgroundColor="Transparent"
                             HorizontalOptions="Fill"/>
                </VerticalStackLayout>

            </Grid>

            <!-- Full-width divider under tab bar -->
            <BoxView HeightRequest="1"
                     BackgroundColor="#E0E0E0"
                     HorizontalOptions="Fill"/>

        </VerticalStackLayout>

        <!-- ══ Row 2 : Loading / Empty states ══════════════════ -->
        <VerticalStackLayout Grid.Row="2" Spacing="0">
            <ActivityIndicator x:Name="LoadingIndicator"
                               IsRunning="True"
                               IsVisible="True"
                               Color="DarkRed"
                               Margin="0,30,0,0"
                               HorizontalOptions="Center"/>
            <Label x:Name="EmptyLabel"
                   Text="No reports found."
                   TextColor="Gray"
                   FontSize="14"
                   FontFamily="PoppinsRegular"
                   IsVisible="False"
                   HorizontalOptions="Center"
                   Margin="0,30,0,0"/>
        </VerticalStackLayout>

        <!-- ══ Row 3 : Scrollable Report Cards ════════════════ -->
        <ScrollView x:Name="ReportsScrollView" Grid.Row="3">
            <VerticalStackLayout x:Name="ReportsContainer"
                                 Spacing="0"
                                 Padding="0,0,0,20"/>
        </ScrollView>

    </Grid>

</ContentPage>
