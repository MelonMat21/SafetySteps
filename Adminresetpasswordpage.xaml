<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SAFETY_STEPS.AdminResetPasswordPage"
             BackgroundColor="White"
             Title="Reset Student Password">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20">

            <!-- Header -->
            <Label Text="Reset Student Password"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="#ab0404"
                   HorizontalOptions="Center"
                   Margin="0,10,0,0"/>

            <Label Text="Enter the student's number to look up their account, then set a temporary password."
                   FontSize="13"
                   TextColor="Gray"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"/>

            <!-- Step 1: Student Number -->
            <Border StrokeShape="RoundRectangle 12"
                    Stroke="#DDDDDD"
                    StrokeThickness="1"
                    Padding="16"
                    BackgroundColor="White">
                <Border.Shadow>
                    <Shadow Brush="#20000000" Offset="0,3" Radius="8" Opacity="1"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="12">
                    <Label Text="Find Student"
                           FontAttributes="Bold"
                           FontSize="15"
                           TextColor="Black"/>

                    <Label Text="Student Number" FontSize="12" TextColor="Gray"/>

                    <Border StrokeShape="RoundRectangle 8"
                            Stroke="#DDDDDD"
                            StrokeThickness="1"
                            Padding="10,0">
                        <Entry x:Name="StudentNumberEntry"
                               TextColor="Black"
                               Placeholder="e.g. 02000"
                               FontSize="14"
                               HeightRequest="44"
                               Keyboard="Text"/>
                    </Border>

                    <Button Text="Search Account"
                            x:Name="SearchButton"
                            Clicked="OnSearchClicked"
                            BackgroundColor="#1565C0"
                            TextColor="White"
                            CornerRadius="10"
                            HeightRequest="44"/>

                    <!-- Result label -->
                    <Label x:Name="SearchResultLabel"
                           Text=""
                           FontSize="13"
                           HorizontalOptions="Center"
                           IsVisible="False"/>
                </VerticalStackLayout>
            </Border>

            <!-- Step 2: Set Password (only visible after successful search) -->
            <Border x:Name="ResetSection"
                    IsVisible="False"
                    StrokeShape="RoundRectangle 12"
                    Stroke="#DDDDDD"
                    StrokeThickness="1"
                    Padding="16"
                    BackgroundColor="White">
                <Border.Shadow>
                    <Shadow Brush="#20000000" Offset="0,3" Radius="8" Opacity="1"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="12">
                    <Label Text="Step 2 — Set Temporary Password"
                           FontAttributes="Bold"
                           FontSize="15"
                           TextColor="Black"/>

                    <Label x:Name="FoundStudentLabel"
                           Text=""
                           FontSize="13"
                           TextColor="#1565C0"
                           FontAttributes="Bold"/>

                    <Label Text="New Temporary Password" FontSize="12" TextColor="Gray"/>

                    <Border StrokeShape="RoundRectangle 8"
                            Stroke="#DDDDDD"
                            StrokeThickness="1"
                            Padding="10,0">
                        <Entry x:Name="NewPasswordEntry"
                               Placeholder="e.g. Student123"
                               TextColor="Black"
                               FontSize="14"
                               HeightRequest="44"
                               IsPassword="True"/>
                    </Border>

                    <Label Text="Confirm Password" FontSize="12" TextColor="Gray"/>

                    <Border StrokeShape="RoundRectangle 8"
                            Stroke="#DDDDDD"
                            StrokeThickness="1"
                            Padding="10,0">
                        <Entry x:Name="ConfirmPasswordEntry"
                               Placeholder="Re-enter password"
                               TextColor="Black"
                               FontSize="14"
                               HeightRequest="44"
                               IsPassword="True"/>
                    </Border>

                    <Button Text="Reset Password"
                            x:Name="ResetButton"
                            Clicked="OnResetClicked"
                            BackgroundColor="#ab0404"
                            TextColor="White"
                            CornerRadius="10"
                            HeightRequest="48"/>

                    <Label x:Name="ResetResultLabel"
                           Text=""
                           FontSize="13"
                           HorizontalOptions="Center"
                           IsVisible="False"/>
                </VerticalStackLayout>
            </Border>

            <!-- Info note -->
            <Border StrokeShape="RoundRectangle 10"
                    Stroke="#FFE082"
                    BackgroundColor="#FFFDE7"
                    Padding="14">
                <VerticalStackLayout Spacing="4">
                    <Label Text="ℹ️  How it works"
                           FontAttributes="Bold"
                           FontSize="13"
                           TextColor="#F57F17"/>
                    <Label Text="1. Student tells you their Student Number."
                           FontSize="12" TextColor="#795548"/>
                    <Label Text="2. Search their account above."
                           FontSize="12" TextColor="#795548"/>
                    <Label Text="3. Set a temporary password (e.g. Student123)."
                           FontSize="12" TextColor="#795548"/>
                    <Label Text="4. Student logs in and should change their password."
                           FontSize="12" TextColor="#795548"/>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
